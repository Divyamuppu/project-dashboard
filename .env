# ── Neon ─────────────────────────────────────────────────────────────────
# Pooled connection string from the Neon dashboard
# (Connection Details → Pooled connection). The host contains "-pooler".
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Admin unlock (password only, no email) ───────────────────────────────
# The dashboard is readable by anyone with the link. This password unlocks
# adding, editing and deleting via "Admin login" in the header.
ADMIN_PASSWORD=

# Signs the session cookie. Generate with: openssl rand -hex 32
# Changing it signs everyone out.
SESSION_SECRET=

# ── Google Sheet / Form sync ─────────────────────────────────────────────
# Shared secret for POST /api/intake and GET /api/projects.
# Generate with: openssl rand -hex 32
# NOT NEXT_PUBLIC_ — must never reach the browser.
INTAKE_SECRET=
